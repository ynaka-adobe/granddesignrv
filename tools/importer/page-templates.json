{
  "metadata": {
    "projectType": "da"
  },
  "templates": [
    {
      "name": "home",
      "urls": [
        "https://www.granddesignrv.com/"
      ],
      "representativeUrl": "https://www.granddesignrv.com/",
      "description": "Grand Design RV homepage: hero carousel, quick links and brand pillar cards, brand tabs with model sliders, featured RV models with Lineage E launch banner, and owner testimonials.",
      "urlPattern": "/",
      "blocks": [
        {
          "name": "carousel-hero",
          "instances": [
            ".carousel.panelcontainer.aem-GridColumn--phone--hide"
          ]
        },
        {
          "name": "cards-callouts",
          "instances": [
            "#homepage-boxes .aem-GridColumn--phone--hide .container.responsivegrid.margin-top-medium.margin-bottom-large.text-center"
          ]
        },
        {
          "name": "cards-promo",
          "instances": [
            "#homepage-boxes .aem-GridColumn--phone--hide .container.responsivegrid.padding-bottom-large"
          ]
        },
        {
          "name": "tabs-brands",
          "instances": [
            ".cmp-homepageslider .tab-content"
          ]
        },
        {
          "name": "hero-banner",
          "instances": [
            ".launchhero"
          ]
        },
        {
          "name": "quote-rating",
          "instances": [
            ".customercomment .q.grid-item"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Hero carousel",
          "selector": [
            ".carousel.panelcontainer.aem-GridColumn--phone--hide"
          ],
          "style": null,
          "blocks": [
            "carousel-hero"
          ],
          "defaultContent": []
        },
        {
          "id": "section-2",
          "name": "Quick links and brand pillars",
          "selector": [
            "#homepage-boxes .container.responsivegrid.full-width:has(.aem-GridColumn--phone--hide .padding-bottom-large)",
            "#container-43103e6c12"
          ],
          "style": "light-grey",
          "blocks": [
            "cards-callouts",
            "cards-promo"
          ],
          "defaultContent": []
        },
        {
          "id": "section-3",
          "name": "Explore our brands",
          "selector": [
            ".slider:has(.cmp-homepageslider)"
          ],
          "style": null,
          "blocks": [
            "tabs-brands"
          ],
          "defaultContent": [
            ".cmp-homepageslider .brandselectortitle h1",
            ".cmp-homepageslider .description p"
          ]
        },
        {
          "id": "section-4",
          "name": "Featured RV innovation",
          "selector": [
            ".text.margin-top-medium.aem-GridColumn--phone--hide"
          ],
          "style": null,
          "blocks": [
            "hero-banner"
          ],
          "defaultContent": [
            ".text.margin-top-medium.aem-GridColumn--phone--hide h1",
            ".aem-Grid > .title.aem-GridColumn--phone--hide",
            ".aem-Grid > .text.margin-bottom-small",
            ".title.aem-GridColumn--phone--hide ~ .image",
            ".title.aem-GridColumn--phone--hide ~ .button",
            ".launchhero + .container.responsivegrid"
          ]
        },
        {
          "id": "section-5",
          "name": "Owner testimonials",
          "selector": [
            ".customercomment"
          ],
          "style": null,
          "blocks": [
            "quote-rating"
          ],
          "defaultContent": [
            ".customercomment .reviewsheader h2"
          ]
        }
      ]
    },
    {
      "name": "travel-trailers",
      "urls": [
        "https://www.granddesignrv.com/travel-trailers"
      ],
      "representativeUrl": "https://www.granddesignrv.com/travel-trailers",
      "description": "Vehicle category landing page: intro (photo + H1 + copy) followed by a stacked model lineup (logo, spin image, stats, headline, copy, CTAs).",
      "blocks": [
        {
          "name": "columns-image-text",
          "instances": [
            ".outer-block.margin-top-medium .inner-block__left:has(+ .inner-block__right h1)"
          ]
        },
        {
          "name": "cards-model-list",
          "instances": [
            ".outer-block.margin-top-medium .aem-Grid > .experiencefragment:has(.dynamicmedia)"
          ]
        }
      ],
      "urlPattern": "/travel-trailers",
      "sections": [
        {
          "id": "section-1",
          "name": "Travel trailers intro and model lineup",
          "selector": [
            ".outer-block.margin-top-medium"
          ],
          "style": null,
          "blocks": [
            "columns-image-text",
            "cards-model-list"
          ],
          "defaultContent": []
        }
      ]
    },
    {
      "name": "shop-and-compare",
      "urls": [
        "https://www.granddesignrv.com/shop-and-compare"
      ],
      "representativeUrl": "https://www.granddesignrv.com/shop-and-compare",
      "description": "Shop and Compare: intro heading + subtitle and the interactive floor plan finder (shop-compare block, reads the floor plan data sheet).",
      "blocks": [
        {
          "name": "shop-compare",
          "instances": [
            ".brandFilter"
          ]
        }
      ],
      "urlPattern": "/shop-and-compare",
      "sections": [
        {
          "id": "section-1",
          "name": "Shop and Compare intro and floor plan finder",
          "selector": [
            ".root > .cmp-container > .container.responsivegrid:has(.brandFilter)"
          ],
          "style": null,
          "blocks": [
            "shop-compare"
          ],
          "defaultContent": [
            ".title.gdrv-title.red.aem-GridColumn--phone--hide h1",
            ".title.heading-scale-secondary.aem-GridColumn--phone--hide h2"
          ]
        }
      ]
    }
  ]
}
