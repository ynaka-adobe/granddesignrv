{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      {
        "message": "Expected class selector to be kebab-case, optionally with BEM __element / --modifier"
      }
    ]
  },
  "overrides": [
    {
      "files": ["blocks/marketo/marketo.css"],
      "rules": {
        "selector-class-pattern": null
      }
    }
  ]
}
